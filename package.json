{
  "name": "nutbox-contract",
  "version": "0.2.0",
  "description": "Nutbox contract repository",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:protocol": "hardhat run scripts/deploy-protocol.js --network bsc",
    "deploy:bsc": "hardhat ignition deploy ignition/modules/NutboxProtocol.js --network bsc --verify --parameters ignition/parameters/bsc.json",
    "deploy:bsc:no-verify": "hardhat ignition deploy ignition/modules/NutboxProtocol.js --network bsc --parameters ignition/parameters/bsc.json",
    "verify:protocol": "echo 'Ignition: use npm run deploy:bsc (includes --verify). Legacy JSON addresses: hardhat verify --network <net> <addr> <args>'",
    "script:mintable-community": "hardhat run scripts/mintable-then-create-community.js --network bsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nutbox-dao/nutbox-contract.git"
  },
  "keywords": [
    "Staking",
    "Solidity"
  ],
  "author": "Nutbox Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nutbox-dao/nutbox-contract/issues"
  },
  "homepage": "https://github.com/nutbox-dao/nutbox-contract#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "chai": "^4.3.4",
    "dotenv": "^10.0.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.4",
    "hardhat-contract-sizer": "^2.10.0",
    "mocha": "^8.3.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.4.1",
    "commander": "^7.2.0"
  }
}
