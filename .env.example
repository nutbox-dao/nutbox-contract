# =============================================================================
# 复制为 .env 后填写（勿将 .env 提交到 Git）
# =============================================================================

# -----------------------------------------------------------------------------
# 部署账户（hardhat.config.js）
# -----------------------------------------------------------------------------
# BSC / BSC 测试网部署使用同一变量；Arbitrum 主网使用 MAIN_KEY
DEPLOY_KEY=
MAIN_KEY=

# -----------------------------------------------------------------------------
# RPC（可选；不填则使用 hardhat.config.js 里的默认公共节点）
# -----------------------------------------------------------------------------
BSC_RPC=
BSC_TESTNET_RPC=

# -----------------------------------------------------------------------------
# scripts/deploy-protocol.js（可选）
# -----------------------------------------------------------------------------
# Committee 收到的原生币手续费归集地址；不填则等于部署钱包地址
FEE_RECIPIENT=

# SocialCuration 链下认领 EIP-712 签名者；不填则等于部署钱包地址
SOCIAL_CURATION_CLAIM_SIGNER=

# -----------------------------------------------------------------------------
# 合约验证
# -----------------------------------------------------------------------------
# 方式 A（推荐，与 pump 一致）：Etherscan Multichain V2 Key
#   https://etherscan.io/apidashboard — 填到 BSC_API_KEY（或 ETHERSCAN_API_KEY）
#   若 Ignition verify 报 Invalid API Key (#err2)，多半是用了「仅 BscScan 旧站」的 Key 却走了 V2 端点。
#
# 方式 B：只有 BscScan 官网申请的 Key 时，打开 legacy 端点：
USE_BSCSCAN_LEGACY_VERIFY=
# 与 legacy 配套（或继续用下面的 BSC_KEY）
BSCSCAN_API_KEY=
#
BSC_API_KEY=
ETHERSCAN_API_KEY=
BSC_KEY=
ARB_KEY=

# -----------------------------------------------------------------------------
# 使用示例
# -----------------------------------------------------------------------------
# npx hardhat run scripts/deploy-protocol.js --network hardhat
# npx hardhat run scripts/deploy-protocol.js --network localhost
#
# BSC 主网（需设置 DEPLOY_KEY）:
# npx hardhat run scripts/deploy-protocol.js --network bsc
#
# 覆盖手续费接收方与 SocialCuration 签名者:
# FEE_RECIPIENT=0x... SOCIAL_CURATION_CLAIM_SIGNER=0x... npx hardhat run scripts/deploy-protocol.js --network bsc
#
# 验证 / Ignition --verify（须设置 BSC_API_KEY 或上述兼容变量之一）:
# npx hardhat run scripts/verify-protocol.js --network bsc
# npm run verify:protocol -- --network bscTestnet
